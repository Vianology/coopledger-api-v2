generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MembershipGrade {
  MEMBER
  ADMIN
  TREASURER
  SECRETARY
}

enum MembershipRole {
  FARMER
  SELLER
}

enum TransactionType {
  COTISATION
  RETRAIT
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum VoteType {
  VOTE_GENERAL
  COTISATION
  RETRAIT
  CANDIDATURE_BUREAU
}

enum VoteStatus {
  OPEN
  CLOSED
  APPROVED
  REJECTED
  EXPIRED
}

model user {
  id                  String          @id @default(cuid())
  email               String          @unique
  emailVerified       Boolean         @default(false)
  name                String
  phoneNumber         String          @unique
  role                String          @default("MEMBER")
  publicKey           String?
  encryptedPrivateKey String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  memberships         membership[]
  transactions        transaction[]
  voteCasts           voteCast[]
  createdCooperatives cooperative[]   @relation("Creator")
  proposedVotes       vote[]          @relation("Proposer")
  accounts            account[]
  sessions            session[]
}

model cooperative {
  id                      String        @id @default(cuid())
  name                    String
  description             String
  logo                    String?
  founders                Json
  latitude                Float?
  longitude               Float?
  encryptionKey           String
  status                  String        @default("ACTIVE")
  fedapayApiKeyPublic     String?
  fedapayApiKeySecret     String?
  payoutEnabled           Boolean       @default(false)
  statusDocumentCid       String?
  proofDocumentCid        String?
  identityDocumentCid     String?
  businessPlanDocumentCid String?
  creatorId               String
  creator                 user          @relation("Creator", fields: [creatorId], references: [id])
  memberships             membership[]
  transactions            transaction[]
  votes                   vote[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}

model membership {
  userId        String
  cooperativeId String
  status        MembershipStatus @default(PENDING)
  grade         MembershipGrade  @default(MEMBER)
  role          MembershipRole   @default(FARMER)
  lastActiveAt  DateTime         @default(now())
  user          user             @relation(fields: [userId], references: [id])
  cooperative   cooperative      @relation(fields: [cooperativeId], references: [id])
  @@id([userId, cooperativeId])
}

model transaction {
  id             String            @id @default(cuid())
  amount         Float
  type           TransactionType
  status         TransactionStatus @default(PENDING)
  description    String?
  ipfsCid        String?
  blockchainHash String?
  receiptHash    String?
  externalId     String?
  userId         String
  cooperativeId  String
  voteId         String?
  user           user              @relation(fields: [userId], references: [id])
  cooperative    cooperative       @relation(fields: [cooperativeId], references: [id])
  vote           vote?             @relation(fields: [voteId], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model vote {
  id                String        @id @default(cuid())
  subject           String
  description       String?
  proposals         Json
  endDate           DateTime
  type              VoteType
  status            VoteStatus    @default(OPEN)
  totalEligibleVoters Int
  amount            Float?
  beneficiary       String?
  paymentDeadline   DateTime?
  cooperativeId     String
  cooperative       cooperative   @relation(fields: [cooperativeId], references: [id])
  creatorId         String
  creator           user          @relation("Proposer", fields: [creatorId], references: [id])
  voteCasts         voteCast[]
  transactions      transaction[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model voteCast {
  id          String   @id @default(cuid())
  voteId      String
  userId      String
  choiceIndex Int
  createdAt   DateTime @default(now())
  vote        vote     @relation(fields: [voteId], references: [id])
  user        user     @relation(fields: [userId], references: [id])
  @@unique([voteId, userId])
}

model account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  updatedAt    DateTime @default(now()) @updatedAt
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
}